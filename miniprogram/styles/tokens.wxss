page { --brand: #116b5a; --brand-strong: #0c5749; --brand-soft: #e4f3ef; --ink: #17221f; --text: #4c5b56; --muted: #78857f; --page: #f5f7f5; --surface: #fff; --line: #e3e8e5; --success: #2d7a58; --success-soft: #e8f4ed; --warning: #af761c; --warning-soft: #fbf1dc; --danger: #b34b48; --danger-soft: #f8e9e8; --info: #326c91; --info-soft: #eaf2f7; background: var(--page); color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
button { margin: 0; padding: 0; border: 0; font: inherit; line-height: normal; } button::after { border: 0; }
.screen { min-height: 100vh; box-sizing: border-box; padding: 28rpx 32rpx calc(56rpx + env(safe-area-inset-bottom)); }.page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin: 12rpx 0 28rpx; }.eyebrow { color: var(--brand); font-size: 21rpx; font-weight: 700; letter-spacing: 2.5rpx; line-height: 1.4; }.page-title { margin-top: 8rpx; color: var(--ink); font-size: 44rpx; font-weight: 700; letter-spacing: -.8rpx; line-height: 1.2; }.page-copy { margin-top: 10rpx; color: var(--text); font-size: 26rpx; line-height: 1.55; }
.card { margin-top: 20rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--surface); padding: 28rpx; }.card-subtle { background: #fbfcfb; }.section-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.section-title { color: var(--ink); font-size: 30rpx; font-weight: 700; line-height: 1.35; }.section-copy { margin-top: 8rpx; color: var(--muted); font-size: 23rpx; line-height: 1.5; }
.primary-button, .secondary-button, .quiet-button, .danger-button { min-height: 88rpx; box-sizing: border-box; border-radius: 20rpx; padding: 0 26rpx; font-size: 28rpx; font-weight: 650; display: flex; align-items: center; justify-content: center; }.primary-button { background: var(--brand); color: #fff; }.secondary-button { background: var(--brand-soft); color: var(--brand-strong); }.quiet-button { border: 1rpx solid var(--line); background: #fff; color: var(--text); }.danger-button { background: var(--danger-soft); color: var(--danger); }.button-row { display: flex; gap: 16rpx; margin-top: 24rpx; }.button-row > button { flex: 1; }
.status-pill { display: inline-flex; align-items: center; gap: 8rpx; max-width: 100%; box-sizing: border-box; border-radius: 999rpx; padding: 10rpx 16rpx; font-size: 22rpx; font-weight: 650; white-space: nowrap; }.status-dot { width: 12rpx; height: 12rpx; flex: 0 0 auto; border-radius: 50%; }.status-idle { background: #eff2f0; color: #5f6e67; }.status-idle .status-dot { background: #93a19a; }.status-success { background: var(--success-soft); color: var(--success); }.status-success .status-dot { background: var(--success); }.status-warning { background: var(--warning-soft); color: var(--warning); }.status-warning .status-dot { background: var(--warning); }.status-danger { background: var(--danger-soft); color: var(--danger); }.status-danger .status-dot { background: var(--danger); }.status-info { background: var(--info-soft); color: var(--info); }.status-info .status-dot { background: var(--info); }
.metric-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 20rpx; }.metric { min-width: 0; border-radius: 20rpx; background: #f7f9f8; padding: 20rpx; }.metric-label { color: var(--muted); font-size: 22rpx; }.metric-value { overflow: hidden; margin-top: 9rpx; color: var(--ink); font-size: 40rpx; font-weight: 720; line-height: 1.05; text-overflow: ellipsis; white-space: nowrap; }.empty-state { padding: 36rpx 18rpx; color: var(--muted); font-size: 26rpx; line-height: 1.6; text-align: center; }.list-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-top: 1rpx solid var(--line); padding: 22rpx 0; }.list-row:first-child { border-top: 0; }.list-title { color: var(--ink); font-size: 28rpx; font-weight: 650; }.list-copy { margin-top: 6rpx; color: var(--muted); font-size: 23rpx; }.notice { margin-top: 20rpx; border-radius: 20rpx; background: var(--info-soft); padding: 20rpx; color: #285975; font-size: 24rpx; line-height: 1.55; }.notice-warning { background: var(--warning-soft); color: #866017; }.notice-danger { background: var(--danger-soft); color: #8f3b39; }.input { box-sizing: border-box; width: 100%; min-height: 84rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: #fff; padding: 0 22rpx; color: var(--ink); font-size: 28rpx; }.field-label { display: block; margin: 24rpx 0 12rpx; color: var(--text); font-size: 25rpx; font-weight: 650; }

/* Transitional compatibility for the retained rehabilitation and remote pages. */
.page-shell { min-height: 100vh; box-sizing: border-box; padding: 28rpx 32rpx calc(56rpx + env(safe-area-inset-bottom)); }.topbar { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; margin: 12rpx 0 28rpx; }.connection-pill { border-radius: 999rpx; background: #eff2f0; padding: 10rpx 16rpx; color: var(--muted); font-size: 22rpx; }.connection-pill.connected { background: var(--success-soft); color: var(--success); }.panel { margin-bottom: 20rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--surface); padding: 28rpx; }.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }.panel-title { color: var(--ink); font-size: 30rpx; font-weight: 700; }.muted { color: var(--muted); font-size: 23rpx; }.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.data-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border-top: 1rpx solid var(--line); padding: 18rpx 0; color: var(--text); font-size: 25rpx; }.primary { background: var(--brand); color: #fff; }.secondary { background: var(--brand-soft); color: var(--brand-strong); }.danger { background: var(--danger-soft); color: var(--danger); }.outline { border: 1rpx solid var(--line); background: #fff; color: var(--text); }.alert { margin-bottom: 20rpx; border-radius: 22rpx; background: var(--danger-soft); padding: 22rpx; color: var(--danger); }.alert-title { font-size: 30rpx; font-weight: 700; }.alert-copy { margin: 8rpx 0 16rpx; font-size: 24rpx; }.feedback { border-radius: 18rpx; background: var(--brand-soft); padding: 20rpx; color: var(--brand-strong); font-size: 25rpx; line-height: 1.5; }.countdown { padding: 24rpx 0; color: var(--brand); font-size: 64rpx; font-weight: 720; text-align: center; }.empty { padding: 30rpx 0; color: var(--muted); font-size: 25rpx; text-align: center; }
