:host { display: block; min-width: 0; }
.monitor { padding: 28rpx; margin-bottom: 24rpx; background: #fff; border: 1rpx solid #e0e5e2; border-radius: 24rpx; box-sizing: border-box; }
.heading { font-size: 32rpx; font-weight: 600; color: #18241e; }
.hint { margin-top: 10rpx; font-size: 24rpx; line-height: 1.5; color: #637169; }
.hand { margin-top: 24rpx; }
.hand-title { margin-bottom: 12rpx; font-size: 28rpx; font-weight: 600; color: #18241e; }
.fingers { display: flex; flex-wrap: wrap; justify-content: space-between; }
.cell { width: 48%; min-width: 0; margin-bottom: 12rpx; box-sizing: border-box; }
