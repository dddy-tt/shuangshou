@import "../../styles/tokens.wxss";
.finger { min-width: 0; box-sizing: border-box; border-radius: 20rpx; background: #f7f9f8; padding: 18rpx; }.finger-head { display: flex; min-width: 0; justify-content: space-between; gap: 8rpx; color: var(--text); font-size: 23rpx; }.finger-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.finger-value { flex: 0 0 auto; color: var(--ink); font-size: 30rpx; font-weight: 720; }.track { height: 12rpx; overflow: hidden; margin-top: 16rpx; border-radius: 999rpx; background: #e6ebe8; }.fill { height: 100%; border-radius: inherit; transition: width .18s ease; }.fill-idle { background: #a0aba5; }.fill-success { background: var(--success); }.fill-warning { background: var(--warning); }.fill-danger { background: var(--danger); }.state { margin-top: 12rpx; font-size: 21rpx; font-weight: 650; }.state-idle { color: var(--muted); }.state-success { color: var(--success); }.state-warning { color: var(--warning); }.state-danger { color: var(--danger); }.finger-disabled { background: #f1f3f2; opacity: .72; }
