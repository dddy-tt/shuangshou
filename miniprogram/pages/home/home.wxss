@import "../../styles/tokens.wxss";
.alarm-banner { margin-bottom: 20rpx; border: 2rpx solid #c74a47; border-radius: 26rpx; background: #fff0ef; padding: 26rpx; color: #7f2927; box-shadow: 0 8rpx 24rpx rgba(145, 52, 49, .12); }.alarm-kicker { color: #b13936; font-size: 21rpx; font-weight: 750; letter-spacing: 2rpx; }.alarm-title { margin-top: 10rpx; font-size: 42rpx; font-weight: 760; }.alarm-copy { margin-top: 10rpx; font-size: 24rpx; line-height: 1.55; }.alarm-audio { margin-top: 14rpx; color: #8f3b39; font-size: 22rpx; }.alarm-button, .alarm-outline-button { flex: 1; min-height: 78rpx; border-radius: 18rpx; font-size: 24rpx; font-weight: 700; }.alarm-button { background: #b83d3a; color: #fff; }.alarm-outline-button { border: 1rpx solid #c74a47; background: transparent; color: #9c3431; }.alarm-hide-button { width: 100%; min-height: 72rpx; margin-top: 14rpx; border: 1rpx solid #d9aaa7; border-radius: 18rpx; background: #fff9f8; color: #8f3b39; font-size: 23rpx; font-weight: 650; }.alarm-hide-button::after { border: 0; }.guardian-entry { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }.guardian-entry > view { min-width: 0; flex: 1; }.guardian-entry .button-row { flex: 1; margin-top: 0; }.guardian-entry-title { color: var(--ink); font-size: 29rpx; font-weight: 720; }.guardian-entry-copy { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.4; }
.device-card { margin-top: 0; }.device-meta { display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; margin-top: 28rpx; }.device-name { color: var(--ink); font-size: 38rpx; font-weight: 720; }.device-copy { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; }.signal { border-radius: 999rpx; background: #eff2f0; padding: 9rpx 13rpx; color: var(--muted); font-size: 21rpx; }.signal-on { background: var(--success-soft); color: var(--success); }.device-list { margin-top: 18rpx; }.quiet-connect { min-height: 64rpx; border-radius: 16rpx; background: var(--brand-soft); padding: 0 18rpx; color: var(--brand-strong); font-size: 24rpx; font-weight: 650; }.quick-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 24rpx; }.quick-item { width: 48%; min-width: 0; min-height: 190rpx; box-sizing: border-box; overflow: hidden; margin-bottom: 14rpx; border: 1rpx solid var(--line); border-radius: 22rpx; background: #fbfcfb; padding: 22rpx; text-align: left; }.quick-index { color: var(--brand); font-size: 21rpx; font-weight: 720; letter-spacing: 1rpx; }.quick-title { overflow: hidden; margin-top: 24rpx; color: var(--ink); font-size: 29rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.quick-copy { overflow: hidden; margin-top: 9rpx; color: var(--muted); font-size: 22rpx; line-height: 1.4; word-break: break-all; }.recent { background: var(--brand-soft); border-color: #d5e9e2; }.recent-label { margin-top: 26rpx; color: var(--brand); font-size: 23rpx; font-weight: 650; }.recent-result { margin-top: 8rpx; color: var(--ink); font-size: 56rpx; font-weight: 730; line-height: 1.15; }.recent-copy { margin-top: 14rpx; color: var(--text); font-size: 24rpx; line-height: 1.55; }
