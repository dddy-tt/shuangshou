@import "../../styles/tokens.wxss";
.gesture-row { border-top: 1rpx solid var(--line); padding: 24rpx 0; }.gesture-row:first-of-type { margin-top: 18rpx; }.gesture-head { display: flex; justify-content: space-between; gap: 16rpx; }.category { align-self: flex-start; border-radius: 999rpx; background: var(--brand-soft); padding: 7rpx 12rpx; color: var(--brand-strong); font-size: 21rpx; }.gesture-meta { margin-top: 14rpx; color: var(--muted); font-size: 22rpx; }.actions { display: flex; gap: 12rpx; margin-top: 20rpx; }.small-button, .small-danger { flex: 1; min-height: 62rpx; border-radius: 15rpx; font-size: 23rpx; }.small-button { background: #f2f5f3; color: var(--text); }.small-danger { background: var(--danger-soft); color: var(--danger); }
