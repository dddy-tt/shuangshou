<view class="screen">
  <view class="page-head">
    <view><view class="eyebrow">DEVICE & DEBUG</view><view class="page-title">设备状态</view><view class="page-copy">用于现场连接确认和排查，不影响翻译数据流。</view></view>
    <status-badge tone="{{tone}}" text="{{label}}" />
  </view>
  <view class="card">
    <section-header title="BLE 链路" copy="{{statusText}}" />
    <view class="info-row"><text>设备</text><text>{{deviceName}}</text></view><view class="info-row"><text>通道</text><text>{{service}}</text></view><view class="info-row"><text>订阅</text><text>{{notify}}</text></view>
    <view class="button-row"><button class="primary-button" bindtap="scan">重新搜索</button><button class="secondary-button" bindtap="disconnect">断开连接</button></view>
  </view>
  <view class="card">
    <section-header title="本地校准" copy="Zero 把当前姿态映射为 0；Full 把当前握满映射为 100。" />
    <view class="cal-state">FLEX Zero：{{calibration.flexZero ? '已记录' : '未记录'}} · Full：{{calibration.flexFull ? '已记录' : '未记录'}} · IMU：{{calibration.imuZero ? '已置零' : '未置零'}}</view>
    <view class="cal-grid"><button class="quiet-button" data-method="captureFlexZero" bindtap="calibrate">FLEX Zero</button><button class="quiet-button" data-method="captureFlexFull" bindtap="calibrate">FLEX Full</button><button class="quiet-button" data-method="captureImuZero" bindtap="calibrate">IMU Zero</button></view>
  </view>
  <view class="card">
    <section-header title="手指通道开关" copy="关闭坏的应变片后，它不会参与翻译、记录和康复匹配。" />
    <view class="finger-switch-grid"><view wx:for="{{fingers}}" wx:key="index" class="finger-switch"><view><view class="finger-switch-name">{{item.label}}</view><view class="finger-switch-copy">{{item.enabled ? '参与识别' : '已排除'}}</view></view><switch checked="{{item.enabled}}" color="#116b5a" data-index="{{item.index}}" bindchange="toggleFinger" /></view></view>
  </view>
  <view class="card">
    <section-header title="JY61P 姿态诊断" copy="显示原始 IMU 数据和固件侧通信结果。" />
    <view class="metric-grid"><view class="metric"><view class="metric-label">Raw Roll</view><view class="metric-value">{{imu.roll}}</view></view><view class="metric"><view class="metric-label">Raw Pitch</view><view class="metric-value">{{imu.pitch}}</view></view><view class="metric"><view class="metric-label">Raw Yaw</view><view class="metric-value">{{imu.yaw}}</view></view></view>
    <view class="notice {{jy.online ? '' : 'notice-warning'}}"><view class="jy-title">{{jy.title}}</view><view class="jy-copy">{{jy.detail}}</view></view>
  </view>
  <view class="card"><section-header title="最近原始帧" copy="仅用于调试；协议解析由共享服务统一完成。" /><view class="raw">{{raw}}</view></view>
  <view class="card"><section-header title="护理演示状态" copy="演示用途，不作为医疗结论。" /><view class="metric-grid"><view class="metric"><view class="metric-label">HR</view><view class="metric-value">{{care.hr}}</view></view><view class="metric"><view class="metric-label">SpO2</view><view class="metric-value">{{care.spo2}}</view></view><view class="metric"><view class="metric-label">警报</view><view class="metric-value">{{care.fall || care.sos ? '是' : '否'}}</view></view></view></view>
  <view class="card"><section-header title="BLE 日志" copy="最近 80 条，本机内存保存。" /><view wx:if="{{!logs.length}}" class="empty-state">尚无蓝牙日志。</view><view wx:for="{{logs}}" wx:key="id" class="log"><text class="log-time">{{item.time}}</text><text class="log-level">{{item.level}}</text><text class="log-text">{{item.message}}</text></view></view>
  <view class="card"><section-header title="开发测试功能" copy="虚拟手套控制台仅用于开发与自动化验证；正式比赛时请勿启动。" /><button class="secondary-button simulator-entry" bindtap="goSimulator">打开虚拟手套控制台</button></view>
</view>
