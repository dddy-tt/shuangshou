@import "../../styles/tokens.wxss";
.info-row { display: flex; justify-content: space-between; gap: 20rpx; border-top: 1rpx solid var(--line); padding: 20rpx 0; color: var(--text); font-size: 25rpx; }.info-row:first-of-type { margin-top: 18rpx; }.info-row text:last-child { max-width: 60%; color: var(--ink); text-align: right; word-break: break-all; }.raw { overflow-x: auto; margin-top: 20rpx; border-radius: 18rpx; background: #f6f8f7; padding: 20rpx; color: #315047; font-family: monospace; font-size: 22rpx; line-height: 1.5; word-break: break-all; }.log { display: grid; grid-template-columns: 100rpx 72rpx 1fr; gap: 10rpx; border-top: 1rpx solid var(--line); padding: 16rpx 0; font-size: 21rpx; line-height: 1.45; }.log-time { color: var(--muted); }.log-level { color: var(--brand); }.log-text { color: var(--text); word-break: break-all; }
.cal-state { margin-top: 20rpx; color: var(--text); font-size: 23rpx; line-height: 1.55; }.cal-grid { display: block; width: 100%; margin-top: 20rpx; }.cal-grid button { display: flex !important; width: 100% !important; min-height: 82rpx; padding: 0 20rpx; font-size: 25rpx; }.cal-grid button + button { margin-top: 14rpx; }.finger-switch-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 22rpx; }.finger-switch { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 10rpx; border-radius: 18rpx; background: #f7f9f8; padding: 18rpx; }.finger-switch-name { overflow: hidden; color: var(--ink); font-size: 25rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }.finger-switch-copy { margin-top: 6rpx; color: var(--muted); font-size: 21rpx; }.jy-title { font-size: 25rpx; font-weight: 700; }.jy-copy { margin-top: 8rpx; font-size: 22rpx; line-height: 1.55; }
.simulator-entry { width: 100%; margin-top: 22rpx; }
