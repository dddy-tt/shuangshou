@import "../../styles/tokens.wxss";
.active-card { margin-bottom: 20rpx; border: 2rpx solid #c74a47; border-radius: 26rpx; background: #fff0ef; padding: 24rpx; color: #7f2927; }.active-kicker { color: #b13936; font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }.active-item + .active-item { margin-top: 24rpx; border-top: 1rpx solid #e5b8b5; padding-top: 22rpx; }.active-title { margin-top: 8rpx; font-size: 39rpx; font-weight: 760; }.active-copy { margin-top: 8rpx; font-size: 23rpx; line-height: 1.5; }.active-audio { margin-top: 12rpx; color: #8f3b39; font-size: 21rpx; }.alarm-button, .resolve-button { flex: 1; min-height: 76rpx; border-radius: 18rpx; font-size: 24rpx; font-weight: 700; }.alarm-button { background: #b83d3a; color: #fff; }.resolve-button { border: 1rpx solid #c74a47; background: transparent; color: #9c3431; }.section-title { color: var(--ink); font-size: 30rpx; font-weight: 720; }.section-copy, .status-copy { margin-top: 10rpx; color: var(--muted); font-size: 23rpx; line-height: 1.55; }.history-item { border-top: 1rpx solid var(--line); padding: 20rpx 0; }.history-item:first-of-type { margin-top: 14rpx; }.history-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.history-title { color: var(--ink); font-size: 28rpx; font-weight: 680; }.history-status { border-radius: 999rpx; padding: 7rpx 12rpx; font-size: 21rpx; }.status-active { background: var(--danger-soft); color: var(--danger); }.status-resolved { background: var(--success-soft); color: var(--success); }.history-copy { margin-top: 7rpx; color: var(--muted); font-size: 21rpx; line-height: 1.45; word-break: break-all; }.full-button { width: 100%; margin-top: 20rpx; }.empty-card { text-align: center; }
