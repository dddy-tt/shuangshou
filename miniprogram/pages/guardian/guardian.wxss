@import "../../styles/tokens.wxss";
.section-title { color: var(--ink); font-size: 30rpx; font-weight: 720; }.section-copy { margin-top: 10rpx; color: var(--muted); font-size: 23rpx; line-height: 1.55; }.role-row { display: flex; gap: 14rpx; margin-top: 22rpx; }.role-button, .role-active { flex: 1; min-height: 86rpx; border-radius: 18rpx; font-size: 25rpx; font-weight: 680; }.role-button { border: 1rpx solid var(--line); background: #fff; color: var(--text); }.role-active { background: var(--brand); color: #fff; }.full-button { width: 100%; margin-top: 20rpx; }.invite-box { margin-top: 20rpx; border-radius: 20rpx; background: var(--brand-soft); padding: 24rpx; text-align: center; }.invite-label { color: var(--brand-strong); font-size: 22rpx; }.invite-code { margin-top: 12rpx; color: var(--ink); font-size: 52rpx; font-weight: 760; letter-spacing: 8rpx; }.invite-copy { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; }.binding-box { margin-top: 18rpx; }.binding-row { display: flex; justify-content: space-between; gap: 16rpx; border-top: 1rpx solid var(--line); padding: 18rpx 0; color: var(--text); font-size: 24rpx; }.binding-row text:last-child { max-width: 65%; color: var(--ink); text-align: right; word-break: break-all; }.online { color: var(--success) !important; }.offline { color: var(--warning) !important; }.status-copy { margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }.guardian-alarm { margin-bottom: 20rpx; border: 2rpx solid #c74a47; border-radius: 24rpx; background: #fff0ef; padding: 24rpx; color: #7f2927; }.alarm-kicker { color: #b13936; font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }.alarm-title { margin-top: 8rpx; font-size: 40rpx; font-weight: 760; }.alarm-copy { margin-top: 10rpx; font-size: 24rpx; line-height: 1.55; }.alarm-audio { margin: 12rpx 0; color: #8f3b39; font-size: 22rpx; }.alarm-button { width: 100%; min-height: 78rpx; border-radius: 18rpx; background: #b83d3a; color: #fff; font-size: 25rpx; font-weight: 700; }.guardian-only { margin-top: 12rpx; color: #8f3b39; font-size: 21rpx; line-height: 1.5; }.input { margin-top: 20rpx; }.notice-danger { margin-top: 16rpx; }
